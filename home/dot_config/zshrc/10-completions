# Completion search paths. Must run before compinit, which oh-my-zsh calls in 20-oh-my-zsh.

# Homebrew zsh completions.
if [[ -n ${HOMEBREW_PREFIX:-} && -d $HOMEBREW_PREFIX/share/zsh/site-functions ]]; then
    fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

# User completions (also where some installers drop _tool files).
[[ -d $HOME/.local/share/zsh/site-functions ]] && fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# zsh-completions, added to fpath directly instead of as an oh-my-zsh plugin.
# https://github.com/zsh-users/zsh-completions/issues/603
[[ -d $HOME/.oh-my-zsh/custom/plugins/zsh-completions/src ]] &&
    fpath=("$HOME/.oh-my-zsh/custom/plugins/zsh-completions/src" $fpath)

# Generated by shrc/50-completions.
[[ -d ${DOTFILES_ZSH_COMPLETIONS:-} ]] && fpath=("$DOTFILES_ZSH_COMPLETIONS" $fpath)
