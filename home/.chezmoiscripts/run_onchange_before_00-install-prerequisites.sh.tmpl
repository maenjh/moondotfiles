#!/bin/bash
# Make sure the tools later scripts depend on exist: git, curl, zsh, and Homebrew on macOS.
set -euo pipefail

DRY_RUN="${DOTFILES_DRY_RUN:-0}"
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
run() {
    if [ "$DRY_RUN" = 1 ]; then printf '  + %s\n' "$*"; else "$@"; fi
}

{{ if eq .chezmoi.os "darwin" -}}
if ! xcode-select -p >/dev/null 2>&1; then
    log "installing Xcode Command Line Tools (finish the dialog, then rerun chezmoi apply)"
    run xcode-select --install || true
fi
if ! command -v brew >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/brew ] && [ ! -x /usr/local/bin/brew ]; then
    log "installing Homebrew"
    if [ "$DRY_RUN" = 1 ]; then
        # shellcheck disable=SC2016 # printed literally
        printf '  + NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"\n'
    else
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi
fi
{{- else if eq .chezmoi.os "linux" -}}
missing=()
for cmd in git curl zsh; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
[ "${#missing[@]}" -eq 0 ] && exit 0

{{ if .is_sudoer -}}
if command -v apt-get >/dev/null 2>&1; then
    log "installing prerequisites with apt: ${missing[*]}"
    run sudo apt-get update -qq
    run sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
    exit 0
fi
{{- end }}
warn "missing prerequisites: ${missing[*]} (no sudo/apt); install them, then rerun chezmoi apply"
{{- end }}
