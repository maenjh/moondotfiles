#!/bin/bash
# Install system packages from .chezmoidata/packages.yaml.
#   Linux: apt (+ snap) when sudo is available, otherwise a writable Homebrew.
#   macOS: Homebrew formulas and casks.
# Packages whose `cmd` is already on PATH are skipped, so this is safe on
# machines where someone else manages the system packages.
# Reruns when this list changes: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# scope={{ .package_scope }} sudo={{ .is_sudoer }}
set -euo pipefail

DRY_RUN="${DOTFILES_DRY_RUN:-0}"
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
run() {
    if [ "$DRY_RUN" = 1 ]; then printf '  + %s\n' "$*"; else "$@"; fi
}
has() { command -v "$1" >/dev/null 2>&1; }

for brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [ -x "$brew" ]; then
        eval "$("$brew" shellenv)"
        break
    fi
done

{{- $rank := dict "minimal" 0 "system" 1 "full" 2 }}
{{- $max := get $rank .package_scope }}

# Each entry is "package|cmd|apt_repo"; cmd and apt_repo may be empty.
APT_PKGS=(
{{- range .packages }}
{{-   if and (get . "apt") (le (get $rank .scope) $max) }}
    {{ printf "%s|%s|%s" (kindIs "string" .apt | ternary (get . "apt") .name) (get . "cmd") (get . "apt_repo") | quote }}
{{-   end }}
{{- end }}
)
SNAP_PKGS=(
{{- range .packages }}
{{-   if and (get . "snap") (le (get $rank .scope) $max) }}
    {{ printf "%s|%s|" (kindIs "string" .snap | ternary (get . "snap") .name) (get . "cmd") | quote }}
{{-   end }}
{{- end }}
)
BREW_PKGS=(
{{- range .packages }}
{{-   if and (get . "brew") (le (get $rank .scope) $max) }}
    {{ printf "%s|%s|" (kindIs "string" .brew | ternary (get . "brew") .name) (get . "cmd") | quote }}
{{-   end }}
{{- end }}
)
# shellcheck disable=SC2034 # used on macOS only
CASK_PKGS=(
{{- range .packages }}
{{-   if and (get . "brewcask") (le (get $rank .scope) $max) }}
    {{ printf "%s|%s|" (kindIs "string" .brewcask | ternary (get . "brewcask") .name) (get . "cmd") | quote }}
{{-   end }}
{{- end }}
)

# apt_repo_info NAME: print "key_url|line" for an apt repository.
apt_repo_info() {
    case "$1" in
{{- range $name, $repo := .apt_repos }}
        {{ $name }}) printf '%s|%s\n' {{ $repo.key_url | squote }} {{ $repo.line | squote }} ;;
{{- end }}
        *) return 1 ;;
    esac
}

# pending CHECK_FN ENTRY...: print entries that still need installing.
# Written for bash 3.2 (macOS /bin/bash): no mapfile, namerefs, or associative arrays.
pending() {
    local check="$1" entry pkg cmd
    shift
    for entry in "$@"; do
        IFS='|' read -r pkg cmd _ <<<"$entry"
        if [ -n "$cmd" ] && has "$cmd"; then continue; fi
        "$check" "$pkg" && continue
        printf '%s\n' "$entry"
    done
}

# read_lines VAR: read stdin lines into array VAR.
read_lines() {
    local line
    eval "$1=()"
    while IFS= read -r line; do
        eval "$1+=(\"\$line\")"
    done
}

apt_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "ok installed"; }
snap_installed() { snap list "${1%% *}" >/dev/null 2>&1; }
brew_installed() { brew list --formula "$1" >/dev/null 2>&1; }
cask_installed() { brew list --cask "$1" >/dev/null 2>&1; }

add_apt_repo() {
    local name="$1"
    local list="/etc/apt/sources.list.d/$name.list"
    local keyring="/etc/apt/keyrings/$name.gpg"
    [ -f "$list" ] && return
    # shellcheck source=/dev/null
    . /etc/os-release
    local arch info key_url line tmp
    arch="$(dpkg --print-architecture)"
    info="$(apt_repo_info "$name")" || { warn "unknown apt repo: $name"; return 1; }
    key_url="${info%%|*}"
    key_url="${key_url//\{id\}/$ID}"
    line="${info#*|}"
    line="${line//\{arch\}/$arch}"
    line="${line//\{keyring\}/$keyring}"
    line="${line//\{id\}/$ID}"
    line="${line//\{codename\}/${VERSION_CODENAME:-}}"
    log "adding apt repository: $name"
    if [ "$DRY_RUN" = 1 ]; then
        printf '  + curl %s -> %s\n  + %s -> %s\n' "$key_url" "$keyring" "$line" "$list"
        return
    fi
    tmp="$(mktemp)"
    curl -fsSL "$key_url" -o "$tmp"
    sudo install -d -m 0755 /etc/apt/keyrings
    if grep -q "BEGIN PGP" "$tmp"; then
        gpg --dearmor <"$tmp" | sudo tee "$keyring" >/dev/null
    else
        sudo install -m 0644 "$tmp" "$keyring"
    fi
    rm -f "$tmp"
    sudo chmod a+r "$keyring"
    echo "$line" | sudo tee "$list" >/dev/null
}

install_apt() {
    local todo=() repos=() entry pkg cmd repo
    read_lines todo < <(pending apt_installed ${APT_PKGS[@]+"${APT_PKGS[@]}"})
    [ "${#todo[@]}" -gt 0 ] || { log "apt packages are up to date"; return; }
    local pkgs=()
    for entry in "${todo[@]}"; do
        IFS='|' read -r pkg cmd repo <<<"$entry"
        pkgs+=("$pkg")
        if [ -n "$repo" ] && [[ " ${repos[*]} " != *" $repo "* ]]; then
            repos+=("$repo")
        fi
    done
    for repo in "${repos[@]}"; do add_apt_repo "$repo"; done
    log "apt install: ${pkgs[*]}"
    run sudo apt-get update -qq
    run sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${pkgs[@]}"
}

install_snap() {
    has snap || return 0
    local todo=() entry pkg
    read_lines todo < <(pending snap_installed ${SNAP_PKGS[@]+"${SNAP_PKGS[@]}"})
    for entry in "${todo[@]}"; do
        IFS='|' read -r pkg _ <<<"$entry"
        log "snap install: $pkg"
        # shellcheck disable=SC2086 # pkg may carry flags such as --classic
        run sudo snap install $pkg
    done
}

# install_brew CHECK_FN FLAG ENTRY...
install_brew() {
    local check="$1" flag="$2"
    local todo=() pkgs=() entry pkg
    shift 2
    read_lines todo < <(pending "$check" "$@")
    [ "${#todo[@]}" -gt 0 ] || { log "brew ${flag:-formulas} are up to date"; return; }
    for entry in "${todo[@]}"; do
        IFS='|' read -r pkg _ <<<"$entry"
        pkgs+=("$pkg")
    done
    log "brew install ${flag}: ${pkgs[*]}"
    # shellcheck disable=SC2086 # empty flag must vanish
    run brew install $flag "${pkgs[@]}" || warn "some brew packages failed: ${pkgs[*]}"
}

brew_writable() { has brew && [ -w "$(brew --prefix)/Cellar" ]; }

report_missing() {
    local todo=() entry pkg names=()
    read_lines todo < <(pending apt_installed ${APT_PKGS[@]+"${APT_PKGS[@]}"})
    for entry in "${todo[@]}"; do
        IFS='|' read -r pkg _ <<<"$entry"
        names+=("$pkg")
    done
    if [ "${#names[@]}" -gt 0 ]; then
        warn "no sudo and no writable Homebrew; not installed: ${names[*]}"
    else
        log "all packages are already available"
    fi
}

{{ if eq .chezmoi.os "darwin" -}}
has brew || { warn "Homebrew is not installed; skipping packages"; exit 0; }
install_brew brew_installed "" ${BREW_PKGS[@]+"${BREW_PKGS[@]}"}
install_brew cask_installed --cask ${CASK_PKGS[@]+"${CASK_PKGS[@]}"}
{{- else if eq .chezmoi.os "linux" -}}
{{-   if .is_sudoer }}
if has apt-get; then
    [ "$DRY_RUN" = 1 ] || sudo -v
    install_apt
    install_snap
    exit 0
fi
{{-   end }}
if brew_writable; then
    install_brew brew_installed "" ${BREW_PKGS[@]+"${BREW_PKGS[@]}"}
else
    report_missing
fi
{{- end }}
