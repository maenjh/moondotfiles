#!/bin/bash
# Install uv and the tools in .chezmoidata/uv_tools.yaml.
# Reruns when this list changes: {{ include ".chezmoidata/uv_tools.yaml" | sha256sum }}
set -euo pipefail

DRY_RUN="${DOTFILES_DRY_RUN:-0}"
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
run() {
    if [ "$DRY_RUN" = 1 ]; then printf '  + %s\n' "$*"; else "$@"; fi
}

export PATH="$HOME/.local/bin:$PATH"

if ! command -v uv >/dev/null 2>&1; then
    log "installing uv into ~/.local/bin"
    # PATH is managed by ~/.config/shrc/10-path, so keep the installer away from rc files.
    if [ "$DRY_RUN" = 1 ]; then
        printf '  + curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 sh\n'
        exit 0
    fi
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
fi
log "uv: $(uv --version)"

failed=()
install_tool() {
    log "uv tool install $*"
    run uv tool install "$@" || failed+=("$1")
}

{{ range .uv_tools -}}
{{-   if or (not (get . "os")) (eq (get . "os") $.chezmoi.os) }}
install_tool {{ .name | quote }}{{ range (get . "with" | default list) }} --with {{ . | quote }}{{ end }}
{{-   end }}
{{- end }}

if [ "${#failed[@]}" -gt 0 ]; then
    warn "failed: ${failed[*]}"
    warn "if an executable already exists (e.g. from pipx), rerun: uv tool install --force <name>"
fi
