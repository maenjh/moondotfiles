#!/bin/bash
# Post-install Docker setup (package_scope system/full):
#   Linux + sudo: start the service on boot, add $USER to the docker group,
#                 and register the NVIDIA runtime on GPU machines.
#   macOS:        remind to launch Docker Desktop once.
# scope={{ .package_scope }} sudo={{ .is_sudoer }} nvidia={{ .has_nvidia }}
set -euo pipefail

{{ if eq .package_scope "minimal" -}}
exit 0
{{- end }}

DRY_RUN="${DOTFILES_DRY_RUN:-0}"
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
run() {
    if [ "$DRY_RUN" = 1 ]; then printf '  + %s\n' "$*"; else "$@"; fi
}

{{ if eq .chezmoi.os "darwin" -}}
if [ -d /Applications/Docker.app ] && ! docker info >/dev/null 2>&1; then
    log "Docker Desktop is installed; open it once to finish setup: open -a Docker"
fi
{{- else if and (eq .chezmoi.os "linux") .is_sudoer -}}
if ! command -v docker >/dev/null 2>&1; then
    [ "$DRY_RUN" = 1 ] || { warn "docker is not installed; skipping docker setup"; exit 0; }
fi

user="$(id -un)"

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    if ! systemctl is-enabled --quiet docker 2>/dev/null || ! systemctl is-active --quiet docker 2>/dev/null; then
        log "enabling and starting the docker service"
        run sudo systemctl enable --now docker
    fi
fi

if ! id -nG "$user" | tr ' ' '\n' | grep -qx docker; then
    log "adding $user to the docker group (log out and back in, or run: newgrp docker)"
    run sudo groupadd -f docker
    run sudo usermod -aG docker "$user"
fi

{{ if .has_nvidia -}}
if command -v nvidia-ctk >/dev/null 2>&1 || [ "$DRY_RUN" = 1 ]; then
    if ! grep -q '"nvidia"' /etc/docker/daemon.json 2>/dev/null; then
        log "registering the NVIDIA container runtime with docker"
        run sudo nvidia-ctk runtime configure --runtime=docker
        run sudo systemctl restart docker
    fi
else
    warn "nvidia-container-toolkit is not installed; docker --gpus will not work"
fi
{{- end }}
{{- else -}}
# No sudo: docker setup needs an administrator (docker group, service, NVIDIA runtime).
if command -v docker >/dev/null 2>&1 && ! docker info >/dev/null 2>&1; then
    warn "docker is installed but not usable by $(id -un); ask an admin to add you to the docker group"
fi
{{- end }}
